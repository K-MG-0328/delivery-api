# Copy this file to .env and fill in real values.
# .env is gitignored.

# JWT — must be at least 32 characters for HS256
JWT_SECRET=replace-with-32-or-more-character-secret-string

# MySQL
DB_URL=jdbc:mysql://localhost:3306/fooddelivery_db
DB_USERNAME=delivery
DB_PASSWORD=replace-me

# JPA
JPA_DDL_AUTO=update

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
